---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const docs = (await getCollection('cases'))
  .filter((d) => !d.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="实战案例" description="一个真实 AI 产品的决策与踩坑" current="/cases/">
  <div class="container">
    <div class="crumbs"><a href="/">首页</a><span>/</span>实战案例</div>
    <header class="page-head">
      <div class="eyebrow">CASES</div>
      <h1>实战案例：三个真实 AI 产品的决策与踩坑</h1>
      <p class="lead">
        EIA（企业级 B 端）、求职 Agent（个人级 C 端）、AI PM Copilot（Meta 级 Agent 系统）——三个不同层次的 AI 产品，共享同一套设计哲学。这里公开它们的设计原则、架构决策、BadCase 和项目治理过程。既是学习材料，也是作者的求职作品集。
      </p>
    </header>

    <section class="section" style="padding-top:8px">
      <div class="card-grid">
        {docs.map((d) => (
          <a class="doc-card" href={`/cases/${d.id}/`}>
            <span class="dc-order">#{String(d.data.order).padStart(2, '0')}</span>
            <h3>{d.data.title}</h3>
            {d.data.description && <p>{d.data.description}</p>}
            <div class="tag-row">
              {d.data.updated && <span class="verified">✓ 核验 {d.data.updated}</span>}
              {d.data.tags?.map((t) => <span class="tag">{t}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
