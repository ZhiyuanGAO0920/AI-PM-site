---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NAV } from '../consts';
---

<BaseLayout title="页面不存在" description="你访问的页面可能已移动或删除" current="">
  <div class="container">
    <div class="crumbs"><a href="/">首页</a><span>/</span>404</div>
    <header class="page-head">
      <div class="eyebrow">404</div>
      <h1>这个页面走丢了</h1>
      <p class="lead">
        你访问的链接可能已移动或删除。下面是几个常去的地方，挑一个继续：
      </p>
    </header>

    <section class="section" style="padding-top:8px">
      <div class="card-grid">
        {NAV.filter((n) => n.href !== '/search/').map((n) => (
          <a class="doc-card" href={n.href}>
            <h3>{n.label}</h3>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
